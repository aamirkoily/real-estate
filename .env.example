# Copy this file to .env and fill in your own values.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000

# Optional: Google Maps JavaScript API key (enables the interactive results map with price pins).
# Without it, the app still shows Google Maps embeds and directions for every home.
# Create one at https://console.cloud.google.com/google/maps-apis and restrict it to your domain.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
